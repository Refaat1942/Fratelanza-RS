# FRATELANZA Production — Hostinger VPS
# Copy to .env on server: cp .env.production.example .env

APP_NAME=FRATELANZA REAL ESTATE PLATFORM
APP_ENV=production
DEBUG=false
APP_PORT=9000

# Your domain (for reference — configure DNS separately)
DOMAIN=erp.yourdomain.com

# Generate strong secrets:
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_64_CHARS
JWT_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (internal Docker network — do not expose ports)
POSTGRES_USER=fratelanza
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=fratelanza_db
DATABASE_URL=postgresql+asyncpg://fratelanza:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/fratelanza_db
DATABASE_URL_SYNC=postgresql://fratelanza:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/fratelanza_db

REDIS_URL=redis://redis:6379/0

# Leave empty — nginx proxies /api on same port
VITE_API_URL=

# CORS — add your domain
CORS_ORIGINS=https://erp.yourdomain.com,http://187.124.15.14:9000

# Super Admin
SUPER_ADMIN_EMAIL=admin@fratelanza.com
SUPER_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
