# Application
FRATELANZA_ENVIRONMENT=development
FRATELANZA_LOG_LEVEL=INFO
FRATELANZA_LOCALE=en

# SQL Server
FRATELANZA_DB_DRIVER=ODBC Driver 18 for SQL Server
FRATELANZA_DB_SERVER=localhost
FRATELANZA_DB_NAME=FratelanzaBusiness
FRATELANZA_DB_TRUSTED_CONNECTION=true
FRATELANZA_DB_USERNAME=
FRATELANZA_DB_PASSWORD=
FRATELANZA_DB_ENCRYPT=true
FRATELANZA_DB_TRUST_SERVER_CERTIFICATE=true
FRATELANZA_DB_TIMEOUT=30

# Branding
FRATELANZA_CLIENT_DISPLAY_NAME=Fratelanza Client Company
FRATELANZA_LOGO_PATH=
FRATELANZA_PRIMARY_COLOR=#55d6be

# VPS remote admin and licensing control
FRATELANZA_REMOTE_ENABLED=false
FRATELANZA_REMOTE_API_BASE_URL=https://your-vps.example.com/api
FRATELANZA_REMOTE_API_KEY=
FRATELANZA_REMOTE_CLIENT_ID=
FRATELANZA_REMOTE_INSTALLATION_ID=
FRATELANZA_REMOTE_SUPPORT=false
FRATELANZA_REMOTE_DISABLE=true
FRATELANZA_REMOTE_HEARTBEAT_SECONDS=900
