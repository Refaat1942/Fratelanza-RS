# Application
APP_NAME=FRATELANZA REAL ESTATE PLATFORM
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-secure-random-key-in-production
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://fratelanza:fratelanza_secret@postgres:5432/fratelanza_db
DATABASE_URL_SYNC=postgresql://fratelanza:fratelanza_secret@postgres:5432/fratelanza_db

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=change-this-jwt-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_S3_ENDPOINT=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@fratelanza.com

# SMS / WhatsApp (configure per provider)
SMS_API_KEY=
WHATSAPP_API_KEY=

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Super Admin (seed)
SUPER_ADMIN_EMAIL=admin@fratelanza.com
SUPER_ADMIN_PASSWORD=Admin@123456

# AI Reporting (OpenAI or Google Gemini — optional; uses local summaries if unset)
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Outbound messages: "log" records only (default). "live" sends email via SMTP.
# Demo tenants are ALWAYS suppressed regardless of this value.
OUTBOUND_MODE=log

# Startup runs Alembic migrations under a Postgres advisory lock
RUN_MIGRATIONS_ON_STARTUP=true

# In-process daily jobs (rent receivables, expiry, reminders). Set false if an external
# scheduler calls POST /api/v1/rentals/jobs/run per tenant instead.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=3600
